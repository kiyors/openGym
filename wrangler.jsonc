// openGym on Cloudflare Workers Free Tier (Web PWA + API + Merged Remote MCP + D1)
// Setup guide: docs/cloudflare-migration/README.md
{
  "$schema": "worker/node_modules/wrangler/config-schema.json",
  "name": "opengym",
  // The kiyors Cloudflare account (wrangler is signed in to several; not a secret).
  "account_id": "b6659ee14f1c076022641fdf51883c0c",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/mcp/*", "/.well-known/*"]
  },
  // Drains webhook retries (worker/src/routes/webhooks.ts runDueWebhooks). Free plan: 5 crons.
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opengym-db",
      "database_id": "46f2b4fe-ef1a-4154-b51b-32b03ba83458",
      "migrations_dir": "worker/migrations"
    }
  ],
  // Optional: uncomment if you later enable custom exercise photo/video uploads (MEDIA_UPLOADS=1).
  // Note: R2 has a 10 GB/month free tier, but requires a payment method on file in Cloudflare.
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "opengym-media"
  //   }
  // ],
  "vars": {
    // Leave RP_ID and ORIGIN unset to auto-derive from your *.workers.dev hostname at runtime.
    // Once you pick your permanent hostname, you may optionally pin them here.
    "RP_NAME": "openGym",
    "SESSION_DAYS": "90",
    "FIRST_USER_ADMIN": "1",
    "INVITE_ONLY": "1",
    "ALLOW_GUEST": "0",
    "PASSWORD_LOGIN": "0",
    "API_TOKENS": "1",
    "MCP": "on",
    "MEDIA_UPLOADS": "0",
    "INTEGRATIONS": "webhook",
    "AUDIT_LOG": "1",
    // The AI Coach is not available on Workers (routes/coach.ts answers like upstream with it off).
    "COACH_DISABLED": "1"
  }
}
